---
layout: null
permalink: /feed.xml
sitemap: false
---
<?xml version="1.0" encoding="utf-8"?>
{%- comment -%}
  Atom feed over the served posts. jekyll-feed only reads _posts, and this
  site's posts are pages, so build it by hand: every page with a work, life or
  balance category and a date, newest first, 20 entries. Dates in front matter
  are a mix of YAML dates and "YYYY-MM-DD HH:MM +0800" strings, which cannot be
  compared directly, so sort on a "YYYYMMDDHHMM|url" key instead.
{%- endcomment -%}
{%- assign keys = "" | split: "" -%}
{%- assign cats = "work,life,balance" | split: "," -%}
{%- for p in site.pages -%}
  {%- if p.date and cats contains p.category -%}
    {%- capture key -%}{{ p.date | date: "%Y%m%d%H%M" }}|{{ p.url }}{%- endcapture -%}
    {%- assign keys = keys | push: key -%}
  {%- endif -%}
{%- endfor -%}
{%- assign keys = keys | sort | reverse -%}
{%- assign newest = keys | first | split: "|" | last -%}
{%- assign newest_page = site.pages | where: "url", newest | first %}
<feed xmlns="http://www.w3.org/2005/Atom" xml:lang="en">
  <title>{{ site.title | xml_escape }}</title>
  <subtitle>{{ site.description | xml_escape }}</subtitle>
  <link href="{{ "/feed.xml" | absolute_url }}" rel="self" type="application/atom+xml"/>
  <link href="{{ "/" | absolute_url }}" rel="alternate" type="text/html"/>
  <id>{{ "/" | absolute_url }}</id>
  <updated>{{ newest_page.date | date_to_xmlschema }}</updated>
  <author>
    <name>{{ site.author.name | xml_escape }}</name>
    <uri>{{ "/" | absolute_url }}</uri>
  </author>
{%- for key in keys limit: 20 -%}
  {%- assign url = key | split: "|" | last -%}
  {%- assign p = site.pages | where: "url", url | first -%}
  {%- assign entry_url = p.url | absolute_url %}
  <entry>
    <title>{{ p.title | remove: " by Rudzainy Rahman" | xml_escape }}</title>
    <link href="{{ entry_url }}" rel="alternate" type="text/html"/>
    <id>{{ entry_url }}</id>
    <published>{{ p.date | date_to_xmlschema }}</published>
    <updated>{{ p.date | date_to_xmlschema }}</updated>
    <category term="{{ p.category }}"/>
    {%- if p.description %}
    <summary>{{ p.description | strip_html | xml_escape }}</summary>
    {%- endif %}
  </entry>
{%- endfor %}
</feed>
